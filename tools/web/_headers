# Cloudflare Pages response headers for a Gwynant game's web app.
# index.html is always revalidated, so a deploy is picked up at once. It loads
# the engine files as name?v=<commit>, so each deploy gets fresh URLs and the
# engine files themselves can be cached for a year.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/s/*
  Cache-Control: no-cache

# Apple fetches this for Universal Links; it must be JSON and never redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# The app's code, gzipped by make-site.py and unzipped by the page itself.
# It is an ordinary file, deliberately without Content-Encoding: gzip, so
# browsers hand the page the gzip bytes. application/gzip is not a type
# Cloudflare compresses, and no-transform asks it to leave the bytes alone.
/*.wasm.gz
  Content-Type: application/gzip
  Cache-Control: public, max-age=31536000, immutable, no-transform

/*.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800
